{
  // Cloudflare merged Pages into Workers; static sites now deploy as a
  // Workers "Static Assets" project. `wrangler deploy` serves .vitepress/dist.
  "name": "portfolio",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": ".vitepress/dist"
  },
  "routes": [
    { "pattern": "maurrod.dev", "custom_domain": true }
  ]
}
